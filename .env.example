# Public web app config. Register one with:
#   firebase apps:create web "Dire Express Admin" --project dire-express
# Then copy the SDK values from `firebase apps:sdkconfig web <APP_ID>`.
# Do not put a service-account private key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="dire-express.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://dire-express-default-rtdb.firebaseio.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="dire-express"
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""

# Server reads (lists the security rules do not allow) and the one-off import.
# JSON from Firebase console → Project settings → Service accounts → Generate new private key.
# Either the raw JSON object or its base64. Never commit the real value.
FIREBASE_SERVICE_ACCOUNT=""
# Optional path instead of the inline JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=""
FIREBASE_DATABASE_URL="https://dire-express-default-rtdb.firebaseio.com"

# Used only by scripts/migrate-postgres-to-rtdb.ts.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/dire_express?schema=public"

# Signs the admin session cookie.
AUTH_SECRET="replace-with-a-long-random-string"

# Optional. `npm run db:seed` creates this email/password admin when Auth has no matching user.
ADMIN_EMAIL="admin@direexpress.com"
ADMIN_PASSWORD="password123"
ADMIN_NAME="Admin"
ADMIN_PHONE=""

# Legacy receipt files that still live on disk in the main app.
MAIN_APP_URL="http://localhost:3000"
