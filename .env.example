# Baked into the static export at build time (`npm run build` and `npm run deploy`).
# Register a web app first:
#   firebase apps:create web "Dire Express Admin" --project dire-express
#   firebase apps:sdkconfig web <APP_ID> --project dire-express
# Do not put a service-account private key in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="dire-express.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://dire-express-default-rtdb.firebaseio.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="dire-express"
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""

# Web OAuth client for the Newsletter page (Gmail API send from the browser). Inlined at build time.
# Google Cloud project dire-express → APIs & Services → Credentials → OAuth client ID → Web application.
# Authorized JavaScript origins: https://dire-express-admin.web.app and http://localhost:3000
# npm run dev listens on port 3001, so also add http://localhost:3001 when sending from the local dashboard.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=""

# Optional. Legacy receipt paths that still live on the main app (`/receipts/...`).
# Inlined at build time. Leave empty to show Realtime Database media and absolute URLs only.
NEXT_PUBLIC_MAIN_APP_URL=""

# The Brevo API key is NOT an environment variable. The Newsletter page asks for it and
# keeps it in this browser's localStorage only. Do not commit a key.

# Local scripts only (`npm run db:migrate`, `npm run db:seed`). The hosted app does not read these.
# Download the JSON from Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT_PATH=""
FIREBASE_DATABASE_URL="https://dire-express-default-rtdb.firebaseio.com"

# Postgres source for the one-off import.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/dire_express?schema=public"

# `npm run db:seed` creates this Firebase Auth user plus adminUsers/{uid} and admins/{uid}.
ADMIN_EMAIL="admin@direexpress.com"
ADMIN_PASSWORD="password123"
ADMIN_NAME="Admin"
ADMIN_PHONE=""
# admin or superadmin. An existing adminUsers.role is left as-is.
ADMIN_ROLE="superadmin"
