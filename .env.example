DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/dire_express?schema=public"
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Local only. In production set AUTH_URL/NEXTAUTH_URL to the public site URL,
# or omit both so trustHost uses the request Host / X-Forwarded-Host.
NEXTAUTH_URL="http://localhost:3001"
MAIN_APP_URL="http://localhost:3000"
